# Copy to .env and fill in. Generate secrets with: openssl rand -hex 32

# Port the web UI (and webhook ingest) is published on
PORT=8080

# Public URL people reach this instance at; used to display ingest URLs
PUBLIC_BASE_URL=http://localhost:8080

# Postgres password (used by both the postgres and backend containers)
POSTGRES_PASSWORD=change-me

# Signs sessions and encrypts stored Discord webhook URLs. At least 32 chars.
APP_SECRET=

# true = no login at all; every request acts as a single local user.
# Only use this when the dashboard is not reachable from the internet.
AUTH_DISABLED=false

# Allow new users to sign up
ALLOW_REGISTRATION=true

# Days to keep delivered/skipped webhook logs (failed ones are kept 2x longer)
EVENT_RETENTION_DAYS=14

LOG_LEVEL=info

# Run the delivery worker inside the API process
RUN_WORKER=true

# --- Only for `npm run dev` outside Docker (compose sets DATABASE_URL itself) ---
# DATABASE_URL=postgres://send-any-webhook:change-me@localhost:5432/send-any-webhook
# PRETTY_LOGS=true
